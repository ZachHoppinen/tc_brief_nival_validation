# inputs + fetched data are gitignored (regenerate via download_paper_data),
# EXCEPT the on-site met CSVs, which cannot be re-fetched and ARE tracked.
data/*
!data/met/
data/met/*
!data/met/*.csv

# generated data products (GUNW, DEM, dSWE/dHS NetCDF) -- regenerate with run_paper_workflow.py
outputs/

__pycache__/
*.pyc
.DS_Store
*.log

# figures: only the paper and supplement deliverables are tracked --
# everything else under figures/ is exploratory and stays local
figures/*
!figures/fig1_context.png
!figures/fig2_results.png
!figures/fig3_swe_timeline.png
!figures/supplement/
figures/supplement/*
!figures/supplement/figS1_coherence_077.png
!figures/supplement/figS2_temperature_profiles.png

# exploratory / one-off analysis scripts
scratch/
